# -- Application ---------------------------------------------------------------
APP_NAME=ark
APP_PORT=3010
# NODE_ENV=production

# -- Data (blobs on filesystem) ------------------------------------------------
# Container default is /data. Host bind-mounts elsewhere via compose.
ARK_DATA_DIR=./data

# -- Database (MySQL) ----------------------------------------------------------
# Bare metal / systemd: localhost. Docker Compose uses host networking and
# keeps localhost unless DOCKER_DATABASE_HOSTNAME is set (remote DB).
DATABASE_HOSTNAME=localhost
DATABASE_PORT=3306
DATABASE_USER=ark
DATABASE_PASSWORD=
DATABASE_NAME=ark
# DATABASE_DEBUG=1
# DOCKER_DATABASE_HOSTNAME=localhost

# -- Session -------------------------------------------------------------------
SESSION_SECRET=change-me-to-a-random-string

# -- Authentication ------------------------------------------------------------
# Optional reverse-proxy identity header (if used in front of ark):
# AUTHELIA_HEADER=
# Bootstrap agent key (plain). Prefer hashed rows in api_keys once created.
# ARK_API_KEY=

# -- Runtime -------------------------------------------------------------------
# Force Docker restart helper even before first up:
# ARK_RUNTIME=docker
