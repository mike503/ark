# ark agent config — copy to agent.yml next to the exe (or pass --config)
#
# This file holds secrets (server API key, optional backup password).
# Keep it private; do not commit it.

# Server connection (env ARK_URL / ARK_API_KEY also work)
url: https://ark.example.com
api_key: "…"

# After a successful extract, push staging to the server immediately.
auto_sync: true

# Optional defaults (CLI flags still win)
# backup: C:\Users\You\Apple\MobileSync\Backup\00008140-…
# out: .\staging

# Backup encryption password (optional). Same sensitivity as api_key.
# Prefer a dedicated machine + locked-down file permissions.
# CLI --password / --password-file and env ARK_BACKUP_PASSWORD also work.
# password: "…"
# password_file: .\backup-password.txt
