# -- Application ---------------------------------------------------------------
APP_NAME=ark
APP_PORT=3010
# NODE_ENV=production

# -- Data (blobs on filesystem) ------------------------------------------------
# Container default is /data. Host bind-mounts via ARK_DATA_HOST in compose.
ARK_DATA_DIR=/data
# ARK_DATA_HOST=./data

# -- Database (MySQL) ----------------------------------------------------------
# Compose uses host networking so localhost reaches a DB on the host.
DATABASE_HOSTNAME=localhost
DATABASE_PORT=3306
DATABASE_USER=ark
DATABASE_PASSWORD=
DATABASE_NAME=ark
# DATABASE_DEBUG=1
# DOCKER_DATABASE_HOSTNAME=localhost

# -- Authentication ------------------------------------------------------------
# Session cookie secret is auto-created in MySQL options.session_secret on first boot.
# Optional reverse-proxy identity header:
# AUTHELIA_HEADER=
# Bootstrap agent API key (plain). Prefer hashed api_keys rows once created.
# ARK_API_KEY=
